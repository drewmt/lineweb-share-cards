{
  "name": "lineweb-share-cards",
  "version": "0.1.0",
  "releaseDate": "2026-08-20 00:00+0000",
  "description": "A WordPress shareable quote image and social card block with optional live WooCommerce product data.",
  "author": "Lineweb",
  "license": "GPL-2.0-or-later",
  "main": "build/share-card/index.js",
  "scripts": {
    "build": "wp-scripts build --experimental-modules --blocks-manifest && node tools/normalize-generated.mjs",
    "check:rtl": "node tools/check-rtl-build.mjs",
    "env:activate": "wp-env run cli wp plugin activate woocommerce lineweb-share-cards",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "lint:php": "find . -path ./node_modules -prune -o -path ./build -prune -o -name '*.php' -exec php -l {} +",
    "plugin-zip": "wp-scripts plugin-zip",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:unit": "wp-scripts test-unit-js --runInBand --no-watchman && php tests/php/run.php"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.52.0",
    "@wordpress/block-editor": "latest",
    "@wordpress/blocks": "latest",
    "@wordpress/components": "latest",
    "@wordpress/element": "^8.4.0",
    "@wordpress/i18n": "latest",
    "qrcode": "^1.5.4"
  },
  "files": [
    "assets",
    "build",
    "includes",
    "languages",
    "lineweb-share-cards.php",
    "readme.txt"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@wordpress/e2e-test-utils-playwright": "^1.52.0",
    "@wordpress/env": "latest",
    "@wordpress/scripts": "^34.0.0"
  }
}
